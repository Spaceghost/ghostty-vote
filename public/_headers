# Headers for the static files under public/. Workers Static Assets applies these
# without invoking the Worker; responses from the Worker (api/*) set their own.
# img-src allows the Lodestone's image hosts for character portraits (img2.finalfantasyxiv.com
# in XIVAuth's fixtures); the Worker only stores portrait URLs on *.finalfantasyxiv.com.
# 'self' is for the admin page's gallery queue (api/admin/gallery/image).
/mods/ffxiv/term/vote/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self'; img-src 'self' data: https://*.finalfantasyxiv.com; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# The plugin (or anything else) may poll these.
/mods/ffxiv/term/vote/version.json
  Access-Control-Allow-Origin: *

/mods/ffxiv/term/vote/ideas.json
  Access-Control-Allow-Origin: *

# The owner's voter list: a static shell with no data (api/admin/voters is gated).
/mods/ffxiv/term/vote/admin/*
  X-Robots-Tag: noindex, nofollow

# Connected apps: approving a device link and listing linked apps (api/device/*, api/apps).
/mods/ffxiv/term/vote/apps/*
  X-Robots-Tag: noindex, nofollow

# The screenshot gallery: its own images only (gallery/img/*, gallery/thumb/*, served by the
# Worker for approved shots only).
/mods/ffxiv/term/gallery/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# The Almanac community model leaderboard: a static page and its own scripts; leaderboard.json
# and recommendations.json are computed by the Worker (which sets their headers).
/mods/ffxiv/almanac/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self'; img-src 'self' data:; media-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# The plugin and other tools read the schemas.
/mods/ffxiv/almanac/schema/*
  Access-Control-Allow-Origin: *

# The plugin repository page: static, same shape as the others. Its only fetch is
# plugins.json on this origin (connect-src 'self').
/mods/ffxiv/plugins/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# The committed fallback listing, served if the Worker ever stops answering this path.
# Dalamud fetches it cross-origin from the game.
/mods/ffxiv/plugins.json
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

# The mods hub and the minisites (Ghostty at term/, XivMcp, XivDesktop; Almanac's is under
# almanac/about/ and takes the almanac rule above). System fonts, so style-src is 'self'
# alone; media-src is for the clips in each mod's media/ folder (docs/MEDIA.md). Exact
# paths for the hub and term/ so these rules never stack a second CSP on the older pages.
/mods/ffxiv/
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; media-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
