{
  "name": "ghostty-vote",
  "private": true,
  "type": "module",
  "description": "Public feature vote for the Ghostty for FFXIV plugin: static page on Workers Static Assets, a tiny API Worker and D1.",
  "scripts": {
    "build": "tools/compile.sh --node-only && node scripts/build.js && tools/compile.sh --browser-only",
    "check": "tools/compile.sh --node-only --check && node scripts/build.js --check && tools/compile.sh --browser-only --check",
    "roadmap": "node scripts/accepted-votes.js",
    "test": "node --test",
    "compile": "tools/compile.sh",
    "test:browser": "node scripts/browser-check.js"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "esbuild": "0.28.1",
    "imba": "2.0.0-alpha.253",
    "playwright": "1.56.1"
  },
  "overrides": {
    "imba": {
      "esbuild": "0.28.1"
    }
  }
}
